<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Cloud backup rules for Android 12+ (API 31+)
        This ensures AsyncStorage data persists even with aggressive battery optimization
    -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="dev-menu.xml" />
    </cloud-backup>
    
    <!--
        Device transfer rules (when user switches devices)
    -->
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="dev-menu.xml" />
    </device-transfer>
</data-extraction-rules>
